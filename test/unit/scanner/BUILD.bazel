# sources that the module scanner (fortran/private/tools/module_order.f90)
# has to read the way the compiler does. every library lists its srcs against
# their dependency order, so a wrong or missed module or use breaks the build

load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//fortran:defs.bzl", "fortran_library", "fortran_test")

# Scenario: statements continued over several lines
# Given use, module and submodule statements split with free-form & and fixed-form column 6
# And a fixed-form `MODULE SUBROUTINE` whose name is on the next line, in two files
# And a fixed-form continuation marked with # in column 6
# And keywords split over two lines, or glued to the name by the join
# When the library is built
# Then each statement is read whole, in any srcs order
fortran_library(
    name = "continuation",
    srcs = [
        "cont/a.f90",
        "cont/b.f90",
        "cont/c.f90",
        "cont/f.f",
        "cont/glued.f",
        "cont/glued.f90",
        "cont/hash_a.f",
        "cont/hash_b.f",
        "cont/s.f90",
        "cont/split.f",
        "cont/split.f90",
        "cont/sub1.f",
        "cont/sub2.f",
        "cont/t.f90",
    ],
    tags = ["manual"],
)

build_test(
    name = "continued_statements_test",
    targets = [":continuation"],
)

# Scenario: ; and ! inside character strings
# Given strings that hold `; use sa` and `; module sc !`, also over a continued string
# When the library is built
# Then no use or module is read out of a string
fortran_library(
    name = "strings",
    srcs = [
        "str/a.f90",
        "str/b.f90",
        "str/c.f90",
    ],
    tags = ["manual"],
)

build_test(
    name = "semicolon_and_bang_in_strings_test",
    targets = [":strings"],
)

# Scenario: an OpenMP conditional line
# Given `!$ use oa` and copts = ["-fopenmp"]
# When the library is built
# Then the use counts, because -fopenmp makes it code
fortran_library(
    name = "omp_sentinel",
    srcs = [
        "omp/a.f90",
        "omp/b.f90",
    ],
    copts = ["-fopenmp"],
    tags = ["manual"],
)

build_test(
    name = "omp_sentinel_use_test",
    targets = [":omp_sentinel"],
)

# Scenario: fixed-form D lines
# Given a D line holding `; MODULE DZ`, and DZ defined in another file
# And a D line holding a USE, built with -fd-lines-as-code
# When both libraries are built
# Then D lines are comments by default and code with -fd-lines-as-code
fortran_library(
    name = "dlines_comment",
    srcs = [
        "dl/a.f",
        "dl/z.f",
    ],
    tags = ["manual"],
)

fortran_library(
    name = "dlines_code",
    srcs = [
        "dl2/x.f",
        "dl2/y.f",
    ],
    copts = ["-fd-lines-as-code"],
    tags = ["manual"],
)

build_test(
    name = "d_lines_test",
    targets = [
        ":dlines_code",
        ":dlines_comment",
    ],
)

# Scenario: modules and uses inside INCLUDE files
# Given a module defined only in an included file, and a use only in an included file
# When the library is built with those files in hdrs
# Then the included files are read as part of the including source
fortran_library(
    name = "fortran_include",
    srcs = [
        "inc/b.f90",
        "inc/mods.f90",
        "inc/u.f90",
    ],
    hdrs = [
        "inc/b_body.inc",
        "inc/c_mod.inc",
    ],
    tags = ["manual"],
)

build_test(
    name = "modules_and_uses_in_include_files_test",
    targets = [":fortran_include"],
)

# Scenario: two sources include the same module file
# Given shared.inc defining module shk, included by two sources of one target
# When the library is built
# Then it is one definition, not a module defined twice
fortran_library(
    name = "shared_include",
    srcs = [
        "shared/a.f90",
        "shared/b.f90",
        "shared/c.f90",
    ],
    hdrs = ["shared/shared.inc"],
    tags = ["manual"],
)

build_test(
    name = "one_include_in_two_sources_test",
    targets = [":shared_include"],
)

# Scenario: modules inside #include files
# Given a module defined only in a #include'd file, and a fragment with another extension
# When the library is built with those files in hdrs
# Then the included files are read and any extension is accepted in hdrs
fortran_library(
    name = "cpp_include",
    srcs = [
        "cppinc/a_user.f90",
        "cppinc/b_mod.F90",
    ],
    hdrs = ["cppinc/m_body.inc"],
    tags = ["manual"],
)

fortran_library(
    name = "fragments",
    srcs = [
        "frag/mod.F90",
        "frag/user.f90",
    ],
    hdrs = ["frag/frag.F90"],
    tags = ["manual"],
)

build_test(
    name = "modules_in_cpp_include_files_test",
    targets = [
        ":cpp_include",
        ":fragments",
    ],
)

# Scenario: a file that includes itself behind an #if guard
# Given a template that #includes itself six times, each under a macro its guard checks
# When the library is built
# Then the scanner reads the file once per source, and does not follow it without end
fortran_library(
    name = "self_include",
    srcs = [
        "selfinc/m.F90",
        "selfinc/k.f90",
    ],
    hdrs = ["selfinc/tmpl.h90"],
    tags = ["manual"],
)

build_test(
    name = "guarded_self_include_test",
    timeout = "short",
    targets = [":self_include"],
)

# Scenario: a byte-order mark and non-breaking spaces
