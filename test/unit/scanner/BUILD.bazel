# Scenario: -Werror in copts
# Given libraries with and without modules, built with copts = ["-Werror"]
# When they are built
# Then the module pass has nothing to warn about
fortran_library(
    name = "werror_modules",
    srcs = [
        "werror/kinds.f90",
        "werror/solver.f90",
    ],
    copts = ["-Werror"],
    tags = ["manual"],
)

fortran_library(
    name = "werror_no_modules",
    srcs = [
        "werror2/x.f90",
        "werror2/y.f90",
    ],
    copts = ["-Werror"],
    tags = ["manual"],
)

build_test(
    name = "module_pass_with_werror_test",
    targets = [
        ":werror_modules",
        ":werror_no_modules",
    ],
)

# Scenario: a form switch in copts
# Given a .f90 module with a line past column 72, and copts = ["-ffixed-form"]
# When a program using the module runs
# Then the exported module matches the object: the .f90 was read in free form both times
fortran_library(
    name = "form_switch",
    srcs = [
        "form/drive.f",
        "form/nekmod.f90",
    ],
    copts = ["-ffixed-form"],
    tags = ["manual"],
)

fortran_test(
    name = "copts_form_switch_matches_objects_test",
    srcs = ["form/p.f90"],
    deps = [":form_switch"],
)

# Scenario: defines with the preprocessor turned on in copts
# Given a lowercase .f module with #ifdef MPI, copts = ["-cpp"] and defines = ["MPI"]
# When a program using the MPI branch runs
# Then the module pass and the compile of that source both saw the define
fortran_library(
    name = "defines_scope",
    srcs = [
        "defs/comm.f",
        "defs/timer.F",
    ],
    copts = ["-cpp"],
    defines = ["MPI"],
    tags = ["manual"],
)

fortran_test(
    name = "defines_reach_both_passes_test",
    srcs = ["defs/p.f90"],
    deps = [":defines_scope"],
)

# Scenario: a module named like one of a dependency
# Given a library whose cfg module shadows a dep's cfg module
# When a program using the library runs
# Then the library's sources saw their own cfg
fortran_library(
    name = "shadow_dep",
    srcs = ["shadow/dep/cfg.f90"],
    tags = ["manual"],
)

fortran_library(
    name = "shadow_tgt",
    srcs = [
        "shadow/tgt/cfg.f90",
        "shadow/tgt/checks.f90",
    ],
    tags = ["manual"],
    deps = [":shadow_dep"],
)

fortran_test(
    name = "own_modules_shadow_deps_test",
    srcs = ["shadow/p.f90"],
    deps = [":shadow_tgt"],
)

# Scenario: the scanner's own errors and limits
# Given cycles, duplicates and a chain of 3000 modules
# When the scanner runs on them directly
# Then it orders the chain without running out of stack, and names the files in its errors
sh_test(
    name = "module_order_test",
    srcs = ["module_order_test.sh"],
    args = ["$(rlocationpath //fortran/private/tools:module_order)"],
    data = [
        "//fortran/private/tools:module_order",
        "@bazel_tools//tools/bash/runfiles",
    ],
)
