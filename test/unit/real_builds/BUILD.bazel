"""Tests that compile, link and run, for behavior analysis tests cannot see."""

load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("//:defs.bzl", "fortran_test")

# given an uppercase-extension source and a define
# then the preprocessor runs and the define selects the passing branch
fortran_test(
    name = "defines_reach_preprocessor_test",
    srcs = ["preprocessed.F90"],
    defines = ["EXPECTED_DEFINE"],
)

# given a source produced by another rule
# then it compiles like a checked-in one
write_file(
    name = "generated_src",
    out = "gen/generated.f90",
    content = [
        "program generated",
        "  implicit none",
        "  if (1 + 1 /= 2) stop 1",
        "end program generated",
        "",
    ],
)

fortran_test(
    name = "generated_source_test",
    srcs = [":generated_src"],
)
