"""Root BUILD file for rules_fortran."""

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
    "README.md",
])

filegroup(
    name = "all_files",
    srcs = glob(["**/*"]),
)

filegroup(
    name = "srcs",
    testonly = True,
    srcs = [
        "BUILD.bazel",
        "MODULE.bazel",
        "//fortran:srcs",
    ],
    visibility = ["//test:__subpackages__"],
)
